{
  "name": "bmoas",
  "version": "0.1.0",
  "private": true,
  "description": "SIT314 simulated media observation platform \u2014 implementation baseline",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --test test/unit.test.js test/flow.test.js test/pipeline.test.js test/infra.test.js test/revision.test.js test/aggregation-batch.test.js test/capacity-schedule.test.js",
    "check": "node scripts/check.js",
    "test:integration": "node --test test/mongo.integration.test.js test/aggregation-batch.integration.test.js",
    "init": "node --env-file-if-exists=.env scripts/init-db.js",
    "node-red": "node --env-file-if-exists=.env src/services/node-red.js",
    "validator": "node --env-file-if-exists=.env src/services/validator.js",
    "aggregator": "node --env-file-if-exists=.env src/services/aggregator.js",
    "api": "node --env-file-if-exists=.env src/services/api.js",
    "simulate": "node --env-file-if-exists=.env src/simulator/cli.js",
    "bridge": "node --env-file-if-exists=.env scripts/local-bridge.js",
    "collect": "node --env-file-if-exists=.env scripts/collect.js",
    "demo:offline": "node scripts/offline-demo.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.900.0",
    "mqtt": "5.15.2",
    "mongodb": "7.3.0",
    "node-red": "4.1.10",
    "express": "4.22.1"
  },
  "license": "UNLICENSED"
}
