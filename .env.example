# LOCAL ONLY. Copy to .env. Run scripts/local-init.sh to generate API_TOKEN.
AWS_REGION=ap-southeast-2
SQS_ENDPOINT=http://127.0.0.1:9324
QUEUE_RAW_URL=http://127.0.0.1:9324/000000000000/raw
QUEUE_CHECKED_URL=http://127.0.0.1:9324/000000000000/checked
QUEUE_AGGREGATE_URL=http://127.0.0.1:9324/000000000000/aggregate
QUEUE_REJECTED_URL=http://127.0.0.1:9324/000000000000/rejected
MONGODB_URI=mongodb://127.0.0.1:27017/bmoas?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=bmoas
MQTT_URL=mqtt://127.0.0.1:1883
API_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
BIND_HOST=127.0.0.1
DEVICE_COUNT=10000
GATEWAY_COUNT=20
WINDOW_SECONDS=60
POLLERS=2
MQTT_TOPIC_PREFIX=bmoas
