{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMOAS transmitted observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "run_id",
    "device_id",
    "panel_id",
    "gateway_id",
    "sequence",
    "observed_at",
    "published_at",
    "media_source_id",
    "region",
    "detection",
    "device",
    "connectivity"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "event_type": {
      "const": "media_observation"
    },
    "run_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "panel_id": {
      "type": "string"
    },
    "gateway_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "media_source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": "string"
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence"
      ],
      "properties": {
        "method": {
          "enum": [
            "simulated",
            "none"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battery_percent",
        "wear_state"
      ],
      "properties": {
        "battery_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "wear_state": {
          "enum": [
            "active",
            "inactive"
          ]
        }
      }
    },
    "connectivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "home_wifi",
            "ble_gateway"
          ]
        }
      }
    }
  }
}
